# ERytmo Authentication & Service Configuration

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=erytmo_super_secret_jwt_key_change_in_production_2026

# Gmail SMTP Email Configuration (For Sending 6-Digit Verification Codes)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Create an App Password at myaccount.google.com/apppasswords
# 3. Paste your full Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="ERytmo Script Converter"
SMTP_FROM_EMAIL=

# Google OAuth 2.0 Configuration (For "Continue with Google")
# 1. Go to Google Cloud Console (console.cloud.google.com) > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Origins: http://localhost:3000, http://127.0.0.1:8000
# 4. Paste your Client ID below:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration (XAMPP MySQL or SQLite)
# To use XAMPP MySQL (phpMyAdmin), start Apache & MySQL in XAMPP, and set:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/erytmo_db
# If left blank, it automatically defaults to local SQLite (backend/database/erytmo.db)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/erytmo_db

